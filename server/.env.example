# Kopie tohoto souboru jako .env (v gitignore), pak doplnit hodnoty.

# JWT secret — vygeneruj přes: openssl rand -hex 32
JWT_SECRET=

# Initial admin se vytvoří automaticky při prvním startu,
# pokud je tabulka users prázdná. Po prvním přihlášení doporučeno
# heslo změnit (přes M4.5 admin UI nebo scripts/reset-pwd.js).
INITIAL_ADMIN_USER=radek
INITIAL_ADMIN_PASSWORD=zmenmehned

# Port pro lokální dev. V produkci za Nginx (proxy_pass 127.0.0.1:3001).
PORT=3001

# Origin Flutter dev serveru (pro CORS v lokálním devu).
# V produkci je vše same-origin a CORS odpadá.
DEV_CORS_ORIGIN=http://localhost:8080

# CORS pro web build servírovaný jinde než API (platí i v produkci).
# Víc originů odděl čárkou. Nativní klienti (EXE/APK) tohle nepotřebují.
# CORS_ORIGIN=http://192.168.1.10:8080,https://app.firma.cz

NODE_ENV=development

# ─── Databáze ────────────────────────────────────────────────────────────
#
# sqlite  — soubory data/users.db + data/units.db, nic se neinstaluje.
#           Používá portable Windows distribuce (appka si server spouští sama).
# mariadb — jedna databáze se všemi tabulkami (users, units, unit_history).
#           Schéma si server vytvoří sám při startu, databáze musí existovat.
DB_DRIVER=sqlite

# Platí jen pro DB_DRIVER=mariadb.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=P2Lunits
# Velikost connection poolu (souběžné dotazy).
DB_CONNECTION_LIMIT=10

# Databáze pro `npm run test:mariadb`. POZOR: testy ji před každým testem
# MAŽOU, takže nikdy nesmí ukazovat na produkční P2Lunits.
TEST_DB_NAME=P2Lunits_test
