# Konfigurace pro docker-compose.yml. Zkopíruj jako `.env.docker` (v gitignore)
# a vyplň hodnoty; compose ji čte přes `--env-file .env.docker`.
#
# Pozn.: tohle NENÍ `server/.env` — ten je pro běh bez Dockeru (`npm start`).
# Do image se `.env` nekopíruje, kontejner konfiguruje výhradně tímto souborem.

# ─── Povinné ─────────────────────────────────────────────────────────────
# Min. 32 znaků, jinak server odmítne nastartovat. Vygeneruj:
#   openssl rand -hex 32
# Změna zneplatní všechny vydané tokeny → klienti se přihlásí znovu.
JWT_SECRET=

# Heslo databázového uživatele. Nastavuje se při PRVNÍM startu (inicializace
# volume `db-data`); pozdější změna tady heslo v databázi nepřepíše.
DB_PASSWORD=

# ─── Databáze (volitelné, defaulty stačí) ────────────────────────────────
DB_NAME=P2Lunits
DB_USER=p2l
DB_CONNECTION_LIMIT=10

# ─── Publikování API ─────────────────────────────────────────────────────
# 127.0.0.1 = jen z toho stroje (typicky za reverzní proxy).
# 0.0.0.0 = dostupné ze sítě — potřeba pro EXE/APK klienty na jiných počítačích.
API_BIND=127.0.0.1
API_PORT=3001

# ─── První admin ─────────────────────────────────────────────────────────
# Vytvoří se jen při prvním startu nad prázdnou tabulkou users. Po přihlášení
# heslo změnit (Nastavení → Účet, nebo `npm run reset-pwd` v kontejneru).
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

# ─── CORS ────────────────────────────────────────────────────────────────
# POVINNÉ, když web běží na jiné adrese než API (např. web na
# p2lweb.domena.cz, API na p2lapi.domena.cz) — bez toho prohlížeč zahodí
# každou odpověď a appka bude vypadat jako rozbitá.
# Přesné schéma + host, BEZ lomítka na konci; víc originů odděl čárkou.
# Prázdné nechat jen tehdy, když web servíruje tentýž origin jako API.
# Nativní klienti (EXE/APK) CORS neřeší.
# CORS_ORIGIN=https://p2lweb.domena.cz

# ─── Webová varianta (služba `web`) ──────────────────────────────────────
# nginx s Flutter web buildem. Při nasazení na vlastní subdoménu (p2lweb.…)
# na něj míří samostatný router v Traefiku; adresu API má appka zabudovanou
# z buildu (--build-arg AUTH_API_BASE), tady se nenastavuje.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Tag image. Pro nasazení přes registry + Portainer sem dej plnou cestu, ať
# `docker compose pull` bere hotovou image místo lokálního buildu:
#   WEB_IMAGE=registry.firma.cz/p2l-tester-web:2.87
# WEB_IMAGE=p2l-tester-web:latest

# Počet reverzních proxy před API — určuje, jakou IP vidí rate limit na
# /api/login. Podle toho, jak routuje Traefik:
#   1 = Traefik jde na `api` přímo (vlastní subdoména p2lapi.… i path routing)
#   2 = Traefik posílá vše na `web` a /api/ přeposílá nginx
# Změnit VE STEJNÉM KROKU jako routing: dvojka nasazená dřív jde obejít
# podvrženou hlavičkou X-Forwarded-For.
TRUST_PROXY=1
