# Konfigurace pro docker-compose.yml. Zkopíruj jako `.env.docker` (v gitignore)
# a vyplň hodnoty; compose ji čte přes `--env-file .env.docker`.
#
# Pozn.: tohle NENÍ `server/.env` — ten je pro běh bez Dockeru (`npm start`).
# Do image se `.env` nekopíruje, kontejner konfiguruje výhradně tímto souborem.

# ─── Povinné ─────────────────────────────────────────────────────────────
# Min. 32 znaků, jinak server odmítne nastartovat. Vygeneruj:
#   openssl rand -hex 32
# Změna zneplatní všechny vydané tokeny → klienti se přihlásí znovu.
JWT_SECRET=

# Heslo databázového uživatele. Nastavuje se při PRVNÍM startu (inicializace
# volume `db-data`); pozdější změna tady heslo v databázi nepřepíše.
DB_PASSWORD=

# ─── Databáze (volitelné, defaulty stačí) ────────────────────────────────
DB_NAME=P2Lunits
DB_USER=p2l
DB_CONNECTION_LIMIT=10

# ─── Publikování API ─────────────────────────────────────────────────────
# 127.0.0.1 = jen z toho stroje (typicky za reverzní proxy).
# 0.0.0.0 = dostupné ze sítě — potřeba pro EXE/APK klienty na jiných počítačích.
API_BIND=127.0.0.1
API_PORT=3001

# ─── První admin ─────────────────────────────────────────────────────────
# Vytvoří se jen při prvním startu nad prázdnou tabulkou users. Po přihlášení
# heslo změnit (Nastavení → Účet, nebo `npm run reset-pwd` v kontejneru).
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

# ─── CORS ────────────────────────────────────────────────────────────────
# Jen když Flutter web build servíruje jiný origin než tento server.
# Víc originů odděl čárkou. Nativní klienti (EXE/APK) CORS neřeší.
# CORS_ORIGIN=https://app.firma.cz
